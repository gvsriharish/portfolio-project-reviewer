# Portfolio Project Reviewer Environment Configuration Example

# Project Settings
PROJECT_NAME="Portfolio Project Reviewer"
API_PREFIX="/api"
HOST="127.0.0.1"
PORT=8000

# Database Storage
DATABASE_URL="sqlite:///./data/portfolio_reviewer.db"

# Google Gemini AI Key (Optional: deterministic grounded fallback engine used if omitted)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Safety Limits
MAX_REPO_SIZE_MB=25
MAX_REPO_FILES=500
MAX_FILE_SIZE_KB=500
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'
